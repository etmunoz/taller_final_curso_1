# Copie este archivo a .env y complete SOLO la clave del proveedor que use.
# .env está en .gitignore: nunca se entrega ni se sube con valores reales.
#
# Proveedor del LLM: google | openai | anthropic | ollama
# Vacío = google, el default del proyecto (pensado para quien ejecute con una
# clave en la nube). Si el proveedor elegido no tiene clave, el proyecto usa
# Ollama local (qwen3:8b) y lo avisa por pantalla.
# Para trabajar siempre local, ponga LLM_PROVIDER=ollama.
LLM_PROVIDER=
# Modelo del proveedor elegido. Vacío = modelo por defecto del proveedor:
#   google    -> gemini-3.5-flash-lite
#   openai    -> gpt-4o-mini
#   anthropic -> claude-sonnet-4-5
#   ollama    -> qwen3:8b
# Si el modelo no corresponde al proveedor (por ejemplo gemini-* con ollama),
# se usa el modelo por defecto de ese proveedor.
MODELO=
# Claves (solo la del proveedor elegido; el resto queda vacía)
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Ollama (local). Por defecto http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
# RAG: Redis Stack (Docker). Por defecto redis://localhost:6379
REDIS_URL=redis://localhost:6379
# Embeddings: ollama | google | openai | local   (vacío = sigue al proveedor del LLM; anthropic → local)
EMBEDDING_PROVIDER=
