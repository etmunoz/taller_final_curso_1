# Grupo: Fabio Durán · Gustavo Reyes · Ezequiel Muñoz
# Archivo: .env.example
# Objetivo: Plantilla de configuración inicial multi-proveedor (Google Gemini, OpenAI, Anthropic u Ollama) y Redis Stack (local o remoto del curso) sin valores secretos.
# Creado: 20261101_1226 (America/Santiago)
# Actualizado: 20261101_2105 (America/Santiago)

# ==============================================================================
# 1. CONFIGURACIÓN DEL PROVEEDOR DE LLM (Google Gemini | OpenAI | Anthropic | Ollama)
# ==============================================================================
# Copie este archivo a .env (cp .env.example .env) y configure el proveedor con
# el que el profesor / persona revisora ejecutará las pruebas:
#
#   Opción A — Google Gemini (por defecto si LLM_PROVIDER queda vacío):
#     LLM_PROVIDER=google
#     MODELO=gemini-3.5-flash-lite
#     GOOGLE_API_KEY=AIzaSy...
#
#   Opción B — OpenAI:
#     LLM_PROVIDER=openai
#     MODELO=gpt-4o-mini
#     OPENAI_API_KEY=sk-...
#
#   Opción C — Anthropic:
#     LLM_PROVIDER=anthropic
#     MODELO=claude-sonnet-4-5
#     ANTHROPIC_API_KEY=sk-ant-...
#
#   Opción D — Ollama local (sin API key; también actúa como respaldo automático):
#     LLM_PROVIDER=ollama
#     MODELO=qwen3:8b
#     OLLAMA_BASE_URL=http://localhost:11434
#
# Nota: Si MODELO se deja vacío o pertenece a otra familia (por ejemplo gemini-*
# con openai), resolver_config() asigna automáticamente el modelo por defecto
# del proveedor elegido.
LLM_PROVIDER=
MODELO=

# Claves de API (complete SOLO la del proveedor que vaya a utilizar; nunca se suben a git)
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Endpoint de Ollama local (por defecto http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# ==============================================================================
# 2. CONFIGURACIÓN DE REDIS STACK (Local en Docker o Redis Remoto del Curso)
# ==============================================================================
# El módulo RAG exige un servidor Redis con RediSearch (módulo 'search' / FT.*).
# Se puede conectar indistintamente a un Redis Stack local o a un Redis remoto:
#
#   - Redis Stack local (Docker):
#       REDIS_URL=redis://localhost:6379
#
#   - Redis remoto del curso (sin TLS o con TLS, con usuario/contraseña):
#       REDIS_URL=redis://usuario:password@host-remoto.curso.cl:6379/0
#       REDIS_URL=rediss://usuario:password@host-remoto.curso.cl:6379/0
#       (Opcionalmente también puede definirse vía REDIS_HOST, REDIS_PORT,
#        REDIS_USERNAME, REDIS_PASSWORD, REDIS_DB y REDIS_SSL=true si no se fija REDIS_URL).
REDIS_URL=redis://localhost:6379
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false

# ==============================================================================
# 3. PROVEEDOR DE EMBEDDINGS PARA RAG
# ==============================================================================
# Opciones: google | openai | ollama | local
#   - Vacío: sigue automáticamente a LLM_PROVIDER (para anthropic usa 'local',
#     y si falta la clave del proveedor en la nube cae automáticamente a 'local'
#     con fastembed sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2).
EMBEDDING_PROVIDER=
