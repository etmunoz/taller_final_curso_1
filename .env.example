# Copie este archivo a .env y complete SOLO la clave del proveedor que use.
# .env está en .gitignore: nunca se entrega ni se sube con valores reales.
# Proveedor del LLM: ollama | google | openai | anthropic
# Por defecto ollama: corre local y no necesita clave.
LLM_PROVIDER=ollama
# Modelo según el proveedor elegido (cambie LLM_PROVIDER y MODELO juntos):
#   ollama    -> etiqueta local; ver `ollama list` (por defecto qwen3:8b)
#   google    -> gemini-3.5-flash-lite
#   openai    -> gpt-5.4-mini (o el que prefiera)
#   anthropic -> identificador vigente en la documentación de Anthropic
MODELO=qwen3:8b
# Claves (solo la del proveedor elegido; el resto queda vacía)
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Ollama (local). Por defecto http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
# RAG: Redis Stack (Docker). Por defecto redis://localhost:6379
REDIS_URL=redis://localhost:6379
# Embeddings: ollama | google | openai | local   (vacío = sigue al proveedor del LLM; anthropic → local)
EMBEDDING_PROVIDER=
