# Grupo: Fabio Durán · Gustavo Reyes · Ezequiel Muñoz
# Archivo: .env.example
# Objetivo: Plantilla de configuración inicial multi-proveedor (Google Gemini, OpenAI, Anthropic u Ollama) y Redis Stack (Redis Cloud del grupo, Redis del curso o Docker local) sin valores secretos.
# Creado: 20261026_1226 (America/Santiago)
# Actualizado: 20261101_1852 (America/Santiago)

# ==============================================================================
# 1. CONFIGURACIÓN DEL PROVEEDOR DE LLM (Google Gemini | OpenAI | Anthropic | Ollama)
# ==============================================================================
# Copie este archivo a .env (Copy-Item .env.example .env) y configure el proveedor
# con el que el profesor / persona revisora ejecutará las pruebas:
#
#   Opción A — Google Gemini (verificado; por defecto si LLM_PROVIDER queda vacío):
#     LLM_PROVIDER=google
#     MODELO=gemini-3.5-flash-lite
#     GOOGLE_API_KEY=AIzaSy...
#
#   Opción B — OpenAI (verificado):
#     LLM_PROVIDER=openai
#     MODELO=gpt-4o-mini
#     OPENAI_API_KEY=sk-...
#
#   Opción C — Anthropic (verificado; alternativa económica: claude-haiku-4-5-20251001):
#     LLM_PROVIDER=anthropic
#     MODELO=claude-sonnet-4-6
#     ANTHROPIC_API_KEY=sk-ant-...
#
#   Opción D — Ollama local (sin API key; también actúa como respaldo automático):
#     LLM_PROVIDER=ollama
#     MODELO=qwen3:8b
#     OLLAMA_BASE_URL=http://localhost:11434
#
# Nota: Si MODELO se deja vacío o pertenece a otra familia (por ejemplo gemini-*
# con openai), resolver_config() asigna automáticamente el modelo por defecto
# del proveedor elegido.
LLM_PROVIDER=
MODELO=

# Claves de API (complete SOLO la del proveedor que vaya a utilizar; nunca se suben a git)
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Endpoint de Ollama local (por defecto http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# ==============================================================================
# 2. CONFIGURACIÓN DE REDIS STACK (Redis Cloud del Grupo, Redis del Curso o Local)
# ==============================================================================
# El código lee SIEMPRE la variable REDIS_URL (o REDIS_HOST/PORT/USERNAME/PASSWORD/DB/SSL
# si REDIS_URL se deja vacía). Copie en REDIS_URL la URL que corresponda evaluar:
#   - Redis Cloud del grupo (REDIS_URL_ALUMNO, entregado por canal privado al docente)
#   - Redis compartido del curso (REDIS_URL_PROFESOR)
#   - Redis Stack local en Docker: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Referencias opcionales (dejar vacías en git; copiar la deseada en REDIS_URL):
REDIS_URL_ALUMNO=
REDIS_URL_PROFESOR=

# Índice y key_prefix únicos del grupo para no colisionar en el Redis compartido del curso:
RAG_INDEX=tfc1_duran_reyes_munoz_bodega_politicas

# Variables separadas alternativas (se usan si REDIS_URL se deja vacía):
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false

# ==============================================================================
# 3. PROVEEDOR DE EMBEDDINGS PARA RAG
# ==============================================================================
# Opciones: google | openai | ollama | local
#   - Vacío: sigue automáticamente a LLM_PROVIDER (google usa gemini-embedding-001
#     con output_dimensionality=768; openai usa text-embedding-3-small con dim=768;
#     anthropic o falta de clave usa fastembed local dim=384).
EMBEDDING_PROVIDER=
